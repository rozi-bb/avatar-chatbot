# Copy to .env and fill in the values. Never commit .env.

# LangSmith: tracing and evaluations
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=avatar-chatbot

# Model provider
DEEPSEEK_API_KEY=

# Azure Speech: text-to-speech and speech-to-text, through short-lived tokens
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia

# Optional backend limits (docs/prd.md §13)
# MAX_TURNS=20
# DAILY_BUDGET_USD=0.16
